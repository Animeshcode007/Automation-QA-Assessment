    {
      "parameters": {
        "jsCode": "\nconst incoming = $input.all().map(item => item.json);\n\nlet repositories = [];\n\n// GitHub search API normally returns an object\n// containing an items array.\nif (incoming.length === 1 && Array.isArray(incoming[0].items)) {\n  repositories = incoming[0].items;\n} else {\n  // Also support input that is already split into repository items.\n  repositories = incoming.filter(\n    repo => repo && typeof repo.full_name === \"string\"\n  );\n}\n\nif (repositories.length === 0) {\n  throw new Error(\"No repositories found. Check the GitHub API response.\");\n}\n\n// Sort repositories by star count, highest first.\nconst top5 = [...repositories]\n  .sort(\n    (a, b) => (b.stargazers_count ?? 0) - (a.stargazers_count ?? 0)\n  )\n  .slice(0, 5)\n  .map(repo => ({\n    id: repo.id,\n    name: repo.name,\n    full_name: repo.full_name,\n    description: repo.description,\n    stars: repo.stargazers_count,\n    language: repo.language,\n    forks: repo.forks_count,\n    url: repo.html_url,\n    updated_at: repo.updated_at\n  }));\n\nreturn [\n  {\n    json: {\n      fetchedCount: repositories.length,\n      selectedCount: top5.length,\n      top5: top5,\n      topRepoFullName: top5[0].full_name,\n      popularThreshold: 50000\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -80
      ],
      "id": "0f3484ce-45b9-4ccd-96ea-79301de61249",
